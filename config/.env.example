# Пример требований к конфигурации будущего приложения. Не содержит ключей.
APP_ENV=development
DEMO_MODE=false
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://app:change_me@localhost:5432/creative_museum
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1600
CHAT_INPUT_TOKEN_BUDGET=8000
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_DEADLINE_SECONDS=45
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Только явно включенный локальный demo может использовать конкурсный demo-пароль.
SESSION_SECRET=
COOKIE_SECURE=false
ACTIVE_CONTEST_SEASON=
DISPLAY_TIMEZONE=Europe/Moscow
SUPPORT_EMAIL=creativemuseum@futuretime.ru
SUPPORT_PHONE=8 800 600-79-31
DAILY_API_BUDGET_USD=5
MONTHLY_API_BUDGET_USD=50
# Значения бюджетов выше — стартовые рабочие допущения, не утвержденные расходы.
MESSAGE_RETENTION_DAYS=365
EXPORT_TTL_HOURS=24
BACKUP_RETENTION_DAYS=30
STORAGE_BACKEND=local
STORAGE_PRIVATE_PATH=./private_storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
