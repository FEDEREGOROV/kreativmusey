{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: API",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Uvicorn running|Started reloader process",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": { "group": "creative-museum", "panel": "dedicated" }
    },
    {
      "label": "Dev: Web",
      "type": "shell",
      "command": "PATH=\"${workspaceFolder}/.tools/node/bin:$PATH\" npm run dev",
      "options": { "cwd": "${workspaceFolder}/apps/web" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "presentation": { "group": "creative-museum", "panel": "dedicated" }
    },
    {
      "label": "Dev: всё приложение",
      "dependsOn": ["Dev: API", "Dev: Web"],
      "dependsOrder": "parallel",
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": []
    },
    {
      "label": "Проверить проект",
      "type": "shell",
      "command": "uv run python -m pytest && PATH=\"${workspaceFolder}/.tools/node/bin:$PATH\" npm --prefix ${workspaceFolder}/apps/web run build && PATH=\"${workspaceFolder}/.tools/node/bin:$PATH\" npm --prefix ${workspaceFolder}/apps/web run lint",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "problemMatcher": []
    }
  ]
}
