APP_ENV=development
DEMO_MODE=true
PUBLIC_BASE_URL=http://127.0.0.1:5173
# Локально приложение использует SQLite по умолчанию. Для PostgreSQL:
# DATABASE_URL=postgresql+psycopg://app:change_me@localhost:5432/creative_museum
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=1600
CHAT_MAX_MESSAGE_CHARS=4000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=konkursadmin
SESSION_SECRET=change_this_before_nonlocal_use
COOKIE_SECURE=false
ACTIVE_CONTEST_SEASON=
DISPLAY_TIMEZONE=Europe/Moscow
SUPPORT_EMAIL=creativemuseum@futuretime.ru
SUPPORT_PHONE=8 800 600-79-31
DAILY_API_BUDGET_USD=5
MONTHLY_API_BUDGET_USD=50
EXPORT_TTL_HOURS=24
